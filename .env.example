# LLM Provider Configuration
# Choose either "ollama" or "gemini"
LLM_PROVIDER=ollama

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_UTILITY_MODEL=
OLLAMA_TEMPERATURE=0.8
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=0
OLLAMA_EMBED_MODEL=nomic-embed-text

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_UTILITY_MODEL=gemini-1.5-flash

# Chat Settings
MAX_HISTORY_MESSAGES=20
DIARY_INTERVAL=5
STREAMING=true
RAG_SCORE_THRESHOLD=0.55
RAG_MIN_MESSAGE_LENGTH=15

# MongoDB
MONGODB_USER=chatbot
MONGODB_PASSWORD=chatbot
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB_NAME=chatbot

# Qdrant (Vector DB for conversation archive)
QDRANT_HOST=localhost
QDRANT_PORT=6333
